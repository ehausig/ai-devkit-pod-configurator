  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/home/devuser/.claude/hooks/notification.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/home/devuser/.claude/hooks/journal.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/devuser/.claude/hooks/bash-logger.sh"
          },
          {
            "type": "command",
            "command": "/home/devuser/.claude/hooks/session-tracker.sh"
          },
          {
            "type": "command",
            "command": "/home/devuser/.claude/hooks/persona-manager.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/home/devuser/.claude/hooks/decision-tracker.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/devuser/.claude/hooks/bash-logger.sh"
          },
          {
            "type": "command",
            "command": "/home/devuser/.claude/hooks/work-queue-monitor.sh"
          },
          {
            "type": "command",
            "command": "/home/devuser/.claude/hooks/project-lifecycle.sh"
          },
          {
            "type": "command",
            "command": "/home/devuser/.claude/hooks/test-tracker.sh"
          },
          {
            "type": "command",
            "command": "/home/devuser/.claude/hooks/error-recovery.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/home/devuser/.claude/hooks/format-code.sh"
          },
          {
            "type": "command",
            "command": "/home/devuser/.claude/hooks/decision-tracker.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "/home/devuser/.claude/hooks/file-milestone.sh"
          }
        ]
      }
    ]
