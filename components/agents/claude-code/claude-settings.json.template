{
  "theme": "dark",
  "verbose": true,
  "includeCoAuthoredBy": true,
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "0",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_COST_WARNINGS": "0",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "0",
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_AUTONOMOUS_MODE": "true"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(*)",
      "Bash(*:*)",
      "Bash(es-event-emit:*)",
      "Bash(es-event-monitor)",
      "Bash(es-projection:*)",
      "Bash(es-actor-base)",
      "Bash(architect-actor)",
      "Bash(developer-actor)",
      "Bash(qa-actor)",
      "Bash(reviewer-actor)",
      "Bash(merger-actor)",
      "Bash(autoexpect:*)",
      "Bash(awk:*)",
      "Bash(black:*)",
      "Bash(bundle:*)",
      "Bash(cargo:*)",
      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(chmod:*)",
      "Bash(composer:*)",
      "Bash(conda:*)",
      "Bash(cp:~/workspace/*)",
      "Bash(curl:*)",
      "Bash(cut:*)",
      "Bash(date:*)",
      "Bash(df:*)",
      "Bash(diff:*)",
      "Bash(docker:*)",
      "Bash(du:*)",
      "Bash(echo:*)",
      "Bash(env:*)",
      "Bash(eval:*)",
      "Bash(expect:*)",
      "Bash(export:*)",
      "Bash(find:*)",
      "Bash(flake8:*)",
      "Bash(free:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(go:*)",
      "Bash(gradle:*)",
      "Bash(grep:*)",
      "Bash(groups:*)",
      "Bash(gunzip:*)",
      "Bash(gzip:*)",
      "Bash(head:*)",
      "Bash(hostname:*)",
      "Bash(htop:*)",
      "Bash(id:*)",
      "Bash(java:*)",
      "Bash(jq:*)",
      "Bash(kill:*)",
      "Bash(killall:*)",
      "Bash(less:*)",
      "Bash(ls:*)",
      "Bash(lsof:*)",
      "Bash(make:*)",
      "Bash(mamba:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(mvn:*)",
      "Bash(netstat:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(patch:*)",
      "Bash(pip:*)",
      "Bash(pkill:*)",
      "Bash(pgrep:*)",
      "Bash(printenv:*)",
      "Bash(ps:*)",
      "Bash(pwd:*)",
      "Bash(pytest:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(ruby:*)",
      "Bash(rustc:*)",
      "Bash(sbt:*)",
      "Bash(sed:*)",
      "Bash(sleep:*)",
      "Bash(sort:*)",
      "Bash(source:*)",
      "Bash(ss:*)",
      "Bash(tail:*)",
      "Bash(tar:*)",
      "Bash(tee:*)",
      "Bash(timeout:*)",
      "Bash(top:*)",
      "Bash(touch:*)",
      "Bash(tr:*)",
      "Bash(uname:*)",
      "Bash(uniq:*)",
      "Bash(unzip:*)",
      "Bash(wc:*)",
      "Bash(wget:*)",
      "Bash(whereis:*)",
      "Bash(which:*)",
      "Bash(whoami:*)",
      "Bash(xmllint:*)",
      "Bash(yarn:*)",
      "Bash(yq:*)",
      "Bash(zip:*)",
      "Edit(~/workspace/*)",
      "Glob(~/workspace/*)",
      "Grep(~/workspace/*)",
      "LS(~/workspace/*)",
      "MultiEdit(~/workspace/*)",
      "NotebookEdit(~/workspace/*)",
      "NotebookRead(~/workspace/*)",
      "Read(~/.bash_profile)",
      "Read(~/.bashrc)",
      "Read(~/.cargo/config.toml)",
      "Read(~/.claude/*)",
      "Read(~/.gitconfig)",
      "Read(~/.m2/settings.xml)",
      "Read(~/.npmrc)",
      "Read(~/.profile)",
      "Read(~/workspace/*)",
      "Read(/etc/ai-devkit-version)",
      "Read(/tmp/*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Write(~/workspace/*)"
    ],
    "deny": [
      "Bash(apt-get:*)",
      "Bash(apt:*)",
      "Bash(chmod:~/.claude/*)",
      "Bash(chmod:~/.ssh/*)",
      "Bash(crontab:*)",
      "Bash(dnf:*)",
      "Bash(dpkg:*)",
      "Bash(fdisk:*)",
      "Bash(firewall-cmd:*)",
      "Bash(groupadd:*)",
      "Bash(halt:*)",
      "Bash(iptables:*)",
      "Bash(mkfs:*)",
      "Bash(mount:*)",
      "Bash(passwd:*)",
      "Bash(poweroff:*)",
      "Bash(reboot:*)",
      "Bash(rm:~/.bundle/*)",
      "Bash(rm:~/.cargo/*)",
      "Bash(rm:~/.claude/*)",
      "Bash(rm:~/.config/*)",
      "Bash(rm:~/.local/*)",
      "Bash(rm:~/.m2/*)",
      "Bash(rm:~/.npm-global/*)",
      "Bash(rm:~/.ssh/*)",
      "Bash(rpm:*)",
      "Bash(service:*)",
      "Bash(shutdown:*)",
      "Bash(su:*)",
      "Bash(sudo:*)",
      "Bash(systemctl:*)",
      "Bash(umount:*)",
      "Bash(useradd:*)",
      "Bash(userdel:*)",
      "Bash(usermod:*)",
      "Bash(yum:*)",
      "Edit(/etc/*)",
      "MultiEdit(/etc/*)",
      "Read(/etc/passwd)",
      "Read(/etc/shadow)",
      "Read(/etc/sudoers)",
      "Read(~/.aws/config)",
      "Read(~/.aws/credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/config)",
      "Read(~/.ssh/*_dsa)",
      "Read(~/.ssh/*_ecdsa)",
      "Read(~/.ssh/*_ed25519)",
      "Read(~/.ssh/*_rsa)",
      "Read(~/.ssh/id_*)",
      "Write(/bin/*)",
      "Write(/etc/*)",
      "Write(/lib/*)",
      "Write(/opt/*)",
      "Write(/root/*)",
      "Write(/sbin/*)",
      "Write(/usr/*)",
      "Write(/var/*)",
      "Write(~/.claude/*)",
      "Write(~/.ssh/*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cc-hook-autonomous-controller.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cc-hook-bash-logger.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cc-hook-bash-logger.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cc-hook-format-code.sh"
          }
        ]
      }
    ]
  }
}
