{
  "theme": "dark",
  "verbose": true,
  "includeCoAuthoredBy": true,
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "0",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_COST_WARNINGS": "0",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "0",
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_AUTONOMOUS_MODE": "true"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/orchestrate.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(*)",
      "Bash(*:*)",
      "Edit(~/workspace/*)",
      "Glob(~/workspace/*)",
      "Grep(~/workspace/*)",
      "LS(~/workspace/*)",
      "MultiEdit(~/workspace/*)",
      "NotebookEdit(~/workspace/*)",
      "NotebookRead(~/workspace/*)",
      "Read(~/.bash_profile)",
      "Read(~/.bashrc)",
      "Read(~/.cargo/config.toml)",
      "Read(~/.claude/*)",
      "Read(~/.gitconfig)",
      "Read(~/.m2/settings.xml)",
      "Read(~/.npmrc)",
      "Read(~/.profile)",
      "Read(~/workspace/*)",
      "Read(/etc/ai-devkit-version)",
      "Read(/tmp/*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Write(~/workspace/*)"
    ],
    "deny": [
      "Bash(rm:~/.claude/*)",
      "Bash(rm:~/.ssh/*)",
      "Bash(rm:/etc/*)",
      "Bash(rm:/usr/*)",
      "Bash(rm:/var/*)",
      "Write(~/.claude/*)",
      "Write(~/.ssh/*)",
      "Write(/etc/*)",
      "Write(/usr/*)",
      "Write(/var/*)"
    ]
  }
}
